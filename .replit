modules = ["nodejs-24", "bun-1.3"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=.replit.dev LOVABLE_PREVIEW_HOST=id-preview--b3784b19-cd44-402a-b597-e4ad2138d929.lovable.app bun run dev -- --host 0.0.0.0 --port 5000 --strictPort"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80
